RETELL_API_KEY=key_your_retell_api_key_here
RETELL_AGENT_ID=agent_your_agent_id_here

# MySQL (AMPPS) — database booking_system
# Matches AMPPS user "127.0.0.1" @ host "localhost" (no password)
DB_HOST=127.0.0.1
DB_USER=127.0.0.1
DB_PASSWORD=
DB_NAME=booking_system

# Optional: Retell webhook when using ngrok in production
WEBHOOK_BASE_URL=http://localhost:3000

# Max wait for post-call analysis before save/not-save (default 3000ms)
# RETELL_ANALYSIS_MAX_MS=3000
# RETELL_ANALYSIS_POLL_MS=400
# SKIP_WEBHOOK_VERIFY=true
