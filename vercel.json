{
    "version": 2,
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [ 
      {
        "src": "/favicon.ico",
        "dest": "/favicon.ico"
      },
      {
        "src": "/favicon.png",
        "dest": "/favicon.png"
      },
      {
        "src": "/(.*)",
        "dest": "server.js"
      }
    ]
  }